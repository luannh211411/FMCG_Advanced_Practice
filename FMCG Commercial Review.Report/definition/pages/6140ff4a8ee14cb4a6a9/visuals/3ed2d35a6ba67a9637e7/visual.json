  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "PERFORMANCE AND TARGETS",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "17px",
                      "color": "#007F86"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "NET SALES  Meaning: recorded sales after discounts. Formula: SUM(Sales[Net Sales]). Example: validated project total $327.109B.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "color": "#374151"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "GROSS MARGIN %  Meaning: margin share of sales. Formula: Total Gross Margin / Total Net Sales. Example: $120.056B / $327.109B = 36.70%.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "color": "#374151"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "TARGET ACHIEVEMENT %  Meaning: sales delivered against target. Formula: Net Sales / Sales Target. Q4 forecast example: $46.504B / $48.841B = 95.22%.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "color": "#374151"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "TARGET VARIANCE  Meaning: amount above or below target. Formula: Net Sales - Sales Target. Forecast comparison: Forecast Sales - Sales Target = -$2.337B.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "color": "#374151"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "VARIANCE %  Meaning: gap relative to target. Formula: variance / Sales Target; blank for zero or unavailable target. Q4 forecast: -$2.337B / $48.841B = -4.78%.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "color": "#374151"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "WAPE  Meaning: weighted aggregate absolute forecast error. Formula: SUM(ABS(Forecast - Actual)) / ABS(SUM(Actual)); unavailable when aggregate actual total is zero. Selected backtest: 5.6729% over 1,512 evaluations.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "color": "#374151"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "BIAS  Meaning: direction and size of aggregate forecast error. Formula: SUM(Forecast - Actual) / SUM(Actual); unavailable when actual total is zero. Positive means over-forecast. Selected backtest: +0.1363%.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "color": "#374151"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "ASP  Meaning: average net sales per unit. Formula: Total Net Sales / Total Quantity. Read in the same filter context; not an unweighted average of prices.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "color": "#374151"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "MONTH-OVER-MONTH GROWTH  Formula: (current Net Sales - previous calendar-month Net Sales) / previous calendar-month Net Sales. Illustrative example: 110 vs 100 = 10%; blank if comparison is unavailable.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "color": "#374151"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
      ]
    },
