/// One row per return record. Keep separate from Sales to avoid double subtraction.
table Returns
	lineageTag: 012e36b6-1c86-4cca-bd20-6ab08233da45

	/// Total return amount from the separate returns fact.
	measure 'Total Return Amount' = SUM('Returns'[Return Amount])
		formatString: $#,##0.00
		displayFolder: Returns
		lineageTag: 8cf9d855-2b65-49fb-b0e3-0650eebfee7e

	/// Total returned units.
	measure 'Total Return Quantity' = SUM('Returns'[Return Quantity])
		formatString: #,##0
		displayFolder: Returns
		lineageTag: 448aa67a-3152-43f1-b9dd-b89b467cf2db

	/// Return amount divided by net sales in the same filter context. Returns remain separate from sales.
	measure 'Return Rate %' = DIVIDE([Total Return Amount], [Total Net Sales])
		formatString: 0.00%
		displayFolder: Returns
		lineageTag: d529fdda-e2dc-4eca-8b44-bccbb66e59b9

	column 'Return ID'
		dataType: string
		isHidden
		isKey
		lineageTag: fde9aee0-1841-4d87-afc5-8ea6257a5ef4
		sourceColumn: ReturnID

	column 'Return Date'
		dataType: dateTime
		formatString: Long Date
		lineageTag: d3d96367-9c2a-4449-93c4-fb7fabe240e0
		summarizeBy: none
		sourceColumn: ReturnDate

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = Automatic

	column 'Transaction ID'
		dataType: string
		isHidden
		lineageTag: 48bd2488-5f88-4f53-8ad2-ee7838eb3319
		sourceColumn: TransactionID

	column 'Customer ID'
		dataType: string
		isHidden
		lineageTag: 45810d1e-3544-4492-bda5-1fb9cff19171
		sourceColumn: CustomerID

	column 'Product ID'
		dataType: string
		isHidden
		lineageTag: 02cb02c8-5632-450d-b68a-ed95eebc5b1e
		sourceColumn: ProductID

	column 'Return Quantity'
		dataType: int64
		lineageTag: f263f7d9-2a3a-49e5-aa73-54618e313f7c
		sourceColumn: ReturnQty

	column 'Return Amount'
		dataType: double
		isHidden
		lineageTag: f2b0ef1a-052a-4899-aa49-9f2f8439a17c
		summarizeBy: sum
		sourceColumn: ReturnAmount

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Return Reason'
		dataType: string
		lineageTag: 13824194-5003-4ddd-a249-1fda70cf89b3
		sourceColumn: ReturnReason

	partition Returns = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        File.Contents("D:\Projects\FMCG_Advanced_Practice\processed\fact_returns.csv"),
				        [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]
				    ),
				    Promoted = Table.PromoteHeaders(
				        Source,
				        [PromoteAllScalars=true]
				    )
				in
				    Table.TransformColumnTypes(
				        Promoted,
				        {
				        {"ReturnDate", type date},
				        {"ReturnQty", Int64.Type},
				        {"ReturnAmount", type number}
				        },
				        "en-US"
				    )

