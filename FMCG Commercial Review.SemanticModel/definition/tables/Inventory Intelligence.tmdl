/// Validated current-state and demand-history screening fields at Snapshot Date × Distributor × Product × Model/Rule Version grain. Inventory quantities are semi-additive and must be read at the latest selected snapshot, not summed across snapshot dates. Coverage-pressure and excess/slow-moving fields are screening signals, not stockout or expiry predictions.
table 'Inventory Intelligence'
	lineageTag: fefa801d-72d4-486e-93ab-f05597e28b13

	/// On-hand units at the latest Snapshot Date in the current context. Inventory is semi-additive; this measure never sums across snapshots.
	measure 'Predictive Latest On Hand Quantity' = VAR _LatestSnapshotDate = MAX('Inventory Intelligence'[Snapshot Date]) RETURN CALCULATE(SUM('Inventory Intelligence'[On Hand Quantity]), KEEPFILTERS('Inventory Intelligence'[Snapshot Date] = _LatestSnapshotDate))
		formatString: #,##0
		displayFolder: Predictive Inventory
		lineageTag: 5bdd62c0-33f1-477f-a59d-056914790a1a

	/// In-transit units at the latest selected Snapshot Date, reported separately from on-hand units.
	measure 'Predictive Latest In Transit Quantity' = VAR _LatestSnapshotDate = MAX('Inventory Intelligence'[Snapshot Date]) RETURN CALCULATE(SUM('Inventory Intelligence'[In Transit Quantity]), KEEPFILTERS('Inventory Intelligence'[Snapshot Date] = _LatestSnapshotDate))
		formatString: #,##0
		displayFolder: Predictive Inventory
		lineageTag: 3f8f7ea1-68ca-4e0c-8cc7-5edf0e0585f0

	/// On-hand plus in-transit units at the latest selected Snapshot Date; this does not mean the in-transit quantity is available now.
	measure 'Predictive Latest Available Inventory Quantity' = VAR _LatestSnapshotDate = MAX('Inventory Intelligence'[Snapshot Date]) RETURN CALCULATE(SUM('Inventory Intelligence'[Available Inventory Quantity]), KEEPFILTERS('Inventory Intelligence'[Snapshot Date] = _LatestSnapshotDate))
		formatString: #,##0
		displayFolder: Predictive Inventory
		lineageTag: afe6107c-5bfd-4187-985c-502ad9432fac

	/// Units reported expired at the latest selected Snapshot Date; does not predict future expiry.
	measure 'Predictive Latest Expired Quantity' = VAR _LatestSnapshotDate = MAX('Inventory Intelligence'[Snapshot Date]) RETURN CALCULATE(SUM('Inventory Intelligence'[Expired Quantity]), KEEPFILTERS('Inventory Intelligence'[Snapshot Date] = _LatestSnapshotDate))
		formatString: #,##0
		displayFolder: Predictive Inventory
		lineageTag: afca94a8-7940-49b9-83c3-d9801c212468

	/// Distinct distributor-product positions with a source-defined Medium/High coverage-pressure screening flag at the latest selected snapshot; not predicted stockouts.
	measure 'Coverage Pressure Positions' = VAR _LatestSnapshotDate = MAX('Inventory Intelligence'[Snapshot Date]) VAR _Positions = CALCULATETABLE(SUMMARIZE('Inventory Intelligence', 'Inventory Intelligence'[Distributor ID], 'Inventory Intelligence'[Product ID]), KEEPFILTERS('Inventory Intelligence'[Snapshot Date] = _LatestSnapshotDate), KEEPFILTERS('Inventory Intelligence'[Low Coverage Pressure Flag] = TRUE())) RETURN COUNTROWS(_Positions)
		formatString: #,##0
		displayFolder: Predictive Inventory
		lineageTag: 76259214-05b5-4083-9afd-f4b24c50d534

	/// Distinct distributor-product positions in the relative High coverage-pressure screening tier at the latest selected snapshot; not a stockout prediction.
	measure 'High Coverage Pressure Positions' = VAR _LatestSnapshotDate = MAX('Inventory Intelligence'[Snapshot Date]) VAR _Positions = CALCULATETABLE(SUMMARIZE('Inventory Intelligence', 'Inventory Intelligence'[Distributor ID], 'Inventory Intelligence'[Product ID]), KEEPFILTERS('Inventory Intelligence'[Snapshot Date] = _LatestSnapshotDate), KEEPFILTERS('Inventory Intelligence'[Coverage Pressure Level] = "High")) RETURN COUNTROWS(_Positions)
		formatString: #,##0
		displayFolder: Predictive Inventory
		lineageTag: ec21454f-bded-4d2f-9522-98337dee4215

	/// Distinct distributor-product positions with a Medium/High excess/slow-moving screening flag at the latest selected snapshot; not future expiry or demand risk.
	measure 'Excess / Slow-Moving Positions' = VAR _LatestSnapshotDate = MAX('Inventory Intelligence'[Snapshot Date]) VAR _Positions = CALCULATETABLE(SUMMARIZE('Inventory Intelligence', 'Inventory Intelligence'[Distributor ID], 'Inventory Intelligence'[Product ID]), KEEPFILTERS('Inventory Intelligence'[Snapshot Date] = _LatestSnapshotDate), KEEPFILTERS('Inventory Intelligence'[Excess / Slow-Moving Flag] = TRUE())) RETURN COUNTROWS(_Positions)
		formatString: #,##0
		displayFolder: Predictive Inventory
		lineageTag: 37933dcd-449c-4c61-a8b7-f1777ec0a4da

	/// Distinct current positions with On Hand below the source reorder point at the latest selected snapshot; a current execution exception, not a stockout prediction.
	measure 'Reorder Exception Positions' = VAR _LatestSnapshotDate = MAX('Inventory Intelligence'[Snapshot Date]) VAR _Positions = CALCULATETABLE(SUMMARIZE('Inventory Intelligence', 'Inventory Intelligence'[Distributor ID], 'Inventory Intelligence'[Product ID]), KEEPFILTERS('Inventory Intelligence'[Snapshot Date] = _LatestSnapshotDate), KEEPFILTERS('Inventory Intelligence'[Reorder Exception Flag] = TRUE())) RETURN COUNTROWS(_Positions)
		formatString: #,##0
		displayFolder: Predictive Inventory
		lineageTag: 6cec915a-aa15-46df-8d1a-0be7cc44e5fe

	/// Distinct positions with source-reported expired quantity at the latest selected snapshot; lot-level expiry dates are unavailable.
	measure 'Expired Inventory Positions' = VAR _LatestSnapshotDate = MAX('Inventory Intelligence'[Snapshot Date]) VAR _Positions = CALCULATETABLE(SUMMARIZE('Inventory Intelligence', 'Inventory Intelligence'[Distributor ID], 'Inventory Intelligence'[Product ID]), KEEPFILTERS('Inventory Intelligence'[Snapshot Date] = _LatestSnapshotDate), KEEPFILTERS('Inventory Intelligence'[Expired Inventory Flag] = TRUE())) RETURN COUNTROWS(_Positions)
		formatString: #,##0
		displayFolder: Predictive Inventory
		lineageTag: f9d8f674-c9e0-4730-9cf0-081c2733631e

	/// Distinct zero-On-Hand positions with supported recent sales demand at the latest selected snapshot; not an estimate of lost sales.
	measure 'Zero On-Hand with Recent Demand Positions' = VAR _LatestSnapshotDate = MAX('Inventory Intelligence'[Snapshot Date]) VAR _Positions = CALCULATETABLE(SUMMARIZE('Inventory Intelligence', 'Inventory Intelligence'[Distributor ID], 'Inventory Intelligence'[Product ID]), KEEPFILTERS('Inventory Intelligence'[Snapshot Date] = _LatestSnapshotDate), KEEPFILTERS('Inventory Intelligence'[Zero On-Hand with Recent Demand Flag] = TRUE())) RETURN COUNTROWS(_Positions)
		formatString: #,##0
		displayFolder: Predictive Inventory
		lineageTag: 6ea6ac89-14eb-4d6b-88b1-6a8f4867a99c

	/// Distinct source-flagged positions with no recent demand at the latest selected snapshot; interpret with available demand-history flags.
	measure 'No Recent Demand Positions' = VAR _LatestSnapshotDate = MAX('Inventory Intelligence'[Snapshot Date]) VAR _Positions = CALCULATETABLE(SUMMARIZE('Inventory Intelligence', 'Inventory Intelligence'[Distributor ID], 'Inventory Intelligence'[Product ID]), KEEPFILTERS('Inventory Intelligence'[Snapshot Date] = _LatestSnapshotDate), KEEPFILTERS('Inventory Intelligence'[No Recent Demand Flag] = TRUE())) RETURN COUNTROWS(_Positions)
		formatString: #,##0
		displayFolder: Predictive Inventory
		lineageTag: 10719235-727b-4e5b-9c84-ae3a4cab1037

