/// Deterministic mixed-grain Q4 2026 management action queue. Grain: one ActionID; commercial-gap rows are Forecast Month × Region × Channel × Category, customer rows are Customer, and inventory rows are Snapshot Date × Distributor × Product. Category is the only supported inventory-to-Q4 geography context. No relationship to Region, Channel, Month, Distributor or Product is created to avoid ambiguous paths and unsupported attribution.
table 'Q4 Action Priority'
	lineageTag: 432a996a-eac6-40ee-a84f-e6c7eebe9ef7

	/// Distinct deterministic action candidates in the current filter context.
	measure 'Action Candidates' = DISTINCTCOUNT('Q4 Action Priority'[Action ID])
		formatString: #,0
		lineageTag: 2a445acf-3908-42cc-b44e-42e6daa4c386

	/// Validated forecast summed over fixed Q4 2026 months; reuses the existing Forecast Sales measure.
	measure 'Q4 Forecast Sales' = CALCULATE([Forecast Sales], REMOVEFILTERS('Date'), 'Sales Forecast'[Forecast Month] >= DATE(2026, 10, 1), 'Sales Forecast'[Forecast Month] < DATE(2027, 1, 1))
		formatString: $#,0;($#,0);-
		lineageTag: 0c7cc056-f9ab-4572-8e8e-2b2493b9873c

	/// Native target at Month × Region × Channel × Category, fixed to Q4 2026.
	measure 'Q4 Sales Target' = CALCULATE([Sales Target], FILTER(ALL('Date'), 'Date'[Month Start] >= DATE(2026, 10, 1) && 'Date'[Month Start] < DATE(2027, 1, 1)))
		formatString: $#,0;($#,0);-
		lineageTag: c89cc815-304d-4eef-aa42-33de452bfe72

	/// Q4 2026 net forecast-to-target gap, using the existing validated forecast and native-grain target measures.
	measure 'Q4 Forecast Target Gap' = [Q4 Forecast Sales] - [Q4 Sales Target]
		formatString: $#,0;($#,0);-
		lineageTag: 12f09945-693f-4716-8167-db94bb93d4a2

	/// Q4 forecast divided by the matching native-grain Q4 target; blank when target is zero.
	measure 'Q4 Projected Target Achievement %' = DIVIDE([Q4 Forecast Sales], [Q4 Sales Target])
		formatString: 0.0%;(0.0%);-
		lineageTag: d6d6b2fa-c875-4288-be1a-01fe97f8db03

	/// Positive magnitude of negative forecast-to-target gaps for the selected native-grain rows.
	measure 'Q4 Gross Target Shortfall' = CALCULATE(-SUM('Q4 Action Priority'[Forecast Target Gap]), KEEPFILTERS('Q4 Action Priority'[Action Type] = "Q4_GAP_REVIEW"))
		formatString: $#,0;($#,0);-
		lineageTag: 207be012-2012-4175-909f-c120b2bd4e7f

	/// Share of the selected gross Q4 shortfall represented by the current native-grain row.
	measure 'Q4 Gap Contribution %' = DIVIDE([Q4 Gross Target Shortfall], CALCULATE([Q4 Gross Target Shortfall], REMOVEFILTERS('Q4 Action Priority'[Region]), REMOVEFILTERS('Q4 Action Priority'[Channel]), REMOVEFILTERS('Q4 Action Priority'[Category]), REMOVEFILTERS('Q4 Action Priority'[Forecast Month])))
		formatString: 0.0%;(0.0%);-
		lineageTag: a1d764a0-62dc-4da9-a5fd-8b8346bb1c65

	/// Q4 shortfall share concentrated in the five largest Region × Channel × Category combinations.
	measure 'Q4 Top 5 Gap Concentration %' = VAR _ByIntersection = SUMMARIZECOLUMNS('Q4 Action Priority'[Region], 'Q4 Action Priority'[Channel], 'Q4 Action Priority'[Category], "Shortfall", [Q4 Gross Target Shortfall]) VAR _TopFive = TOPN(5, _ByIntersection, [Shortfall], DESC) VAR _Selected = SUMX(_TopFive, [Shortfall]) VAR _Total = CALCULATE([Q4 Gross Target Shortfall], REMOVEFILTERS('Q4 Action Priority'[Region]), REMOVEFILTERS('Q4 Action Priority'[Channel]), REMOVEFILTERS('Q4 Action Priority'[Category]), REMOVEFILTERS('Q4 Action Priority'[Forecast Month])) RETURN DIVIDE(_Selected, _Total)
		formatString: 0.0%;(0.0%);-
		lineageTag: 287ad675-e8e5-403e-8bd4-5c78cf63822b

	/// Distinct action candidates rated Critical or High.
	measure 'Critical and High Actions' = CALCULATE([Action Candidates], KEEPFILTERS('Q4 Action Priority'[Priority Level] IN {"Critical", "High"}))
		formatString: #,0
		lineageTag: df79d24e-d93d-464c-96a3-e2558f93dc71

	/// All Core/Maintain customers with validated High decline risk (617 overall; not probability-calibrated).
	measure 'Core High Decline Customer Count' = CALCULATE(DISTINCTCOUNT('Q4 Action Priority'[Customer ID]), KEEPFILTERS('Q4 Action Priority'[Action Type] = "CORE_HIGH_DECLINE_REVIEW"))
		formatString: #,0
		lineageTag: 24d75d20-0b1a-4403-9b21-5afbf393d97f

	/// Deduplicated trailing-12-month sales exposure for the full Core/Maintain + validated High-decline cohort; not estimated recovery.
	measure 'Core High Decline 12M Sales Exposure' = VAR _Customers = CALCULATETABLE(VALUES('Q4 Action Priority'[Customer ID]), KEEPFILTERS('Q4 Action Priority'[Action Type] = "CORE_HIGH_DECLINE_REVIEW")) RETURN SUMX(_Customers, CALCULATE(MAX('Q4 Action Priority'[Trailing 12-Month Sales])))
		formatString: $#,0;($#,0);-
		lineageTag: 739c13ee-5f7e-4831-906e-a514c72a66b4

	/// Recent sales weighted by the validated Q4-gap-relevant share for the full deduplicated cohort; exposure only, not incremental sales.
	measure 'Core High Decline Q4-Relevant Recent Sales' = VAR _Customers = CALCULATETABLE(VALUES('Q4 Action Priority'[Customer ID]), KEEPFILTERS('Q4 Action Priority'[Action Type] = "CORE_HIGH_DECLINE_REVIEW")) RETURN SUMX(_Customers, CALCULATE(MAX('Q4 Action Priority'[Recent 3-Month Sales]) * MAX('Q4 Action Priority'[Q4-Gap-Relevant Sales Share])))
		formatString: $#,0;($#,0);-
		lineageTag: a2750d6e-d10d-4ada-aceb-f0f4bee36ee9

	/// Distinct Potential customers queued for validation; not a causal uplift cohort.
	measure 'Potential Customer Count' = CALCULATE(DISTINCTCOUNT('Q4 Action Priority'[Customer ID]), KEEPFILTERS('Q4 Action Priority'[Action Type] = "POTENTIAL_GROWTH_VALIDATION"))
		formatString: #,0
		lineageTag: f261de94-ccf3-455a-bfa5-0f63cebc9bdc

	/// Deduplicated trailing-12-month sales context for Potential customers; not estimated growth or recovery.
	measure 'Potential 12M Sales Exposure' = VAR _Customers = CALCULATETABLE(VALUES('Q4 Action Priority'[Customer ID]), KEEPFILTERS('Q4 Action Priority'[Action Type] = "POTENTIAL_GROWTH_VALIDATION")) RETURN SUMX(_Customers, CALCULATE(MAX('Q4 Action Priority'[Trailing 12-Month Sales])))
		formatString: $#,0;($#,0);-
		lineageTag: ab058cfb-200e-4b1e-980b-87c0d25f3d3b

	/// Recent sales weighted by the validated Q4-gap-relevant share; used as context, not uplift.
	measure 'Potential Q4-Relevant Recent Sales' = VAR _Customers = CALCULATETABLE(VALUES('Q4 Action Priority'[Customer ID]), KEEPFILTERS('Q4 Action Priority'[Action Type] = "POTENTIAL_GROWTH_VALIDATION")) RETURN SUMX(_Customers, CALCULATE(MAX('Q4 Action Priority'[Recent 3-Month Sales]) * MAX('Q4 Action Priority'[Q4-Gap-Relevant Sales Share])))
		formatString: $#,0;($#,0);-
		lineageTag: 508075a9-b33b-4290-bdbf-2122c5026677

	/// Distinct inventory positions selected by Build 1 for execution or coverage review; not a stockout prediction.
	measure 'Inventory Review Positions' = CALCULATE(DISTINCTCOUNT('Q4 Action Priority'[Action ID]), KEEPFILTERS('Q4 Action Priority'[Action Entity Type] = "Distributor-product inventory position"))
		formatString: #,0
		lineageTag: dd3cbc74-68b7-41c2-8499-7d72ef8a4049

	/// Distinct inventory positions screened at High coverage pressure; lacks lead-time calibration.
	measure 'High Inventory Coverage Pressure Positions' = CALCULATE(DISTINCTCOUNT('Q4 Action Priority'[Action ID]), KEEPFILTERS('Q4 Action Priority'[Action Entity Type] = "Distributor-product inventory position"), KEEPFILTERS('Q4 Action Priority'[Coverage Pressure Level] = "High"))
		formatString: #,0
		lineageTag: 69161e2f-211d-423d-9059-2a02c1cae623

	/// Distinct current snapshot positions where On Hand is below the recorded Reorder Point.
	measure 'Inventory Reorder Exceptions' = CALCULATE(DISTINCTCOUNT('Q4 Action Priority'[Action ID]), KEEPFILTERS('Q4 Action Priority'[Action Entity Type] = "Distributor-product inventory position"), KEEPFILTERS('Q4 Action Priority'[Reorder Exception Flag] = TRUE()))
		formatString: #,0
		lineageTag: d4036a0e-67cc-4a12-be6e-178010ed6206

	/// Distinct action candidates at the Critical threshold.
	measure 'Critical Actions' = CALCULATE([Action Candidates], KEEPFILTERS('Q4 Action Priority'[Priority Level] = "Critical"))
		formatString: #,0
		lineageTag: ed8c96ba-1e7c-4bf5-a98e-a15692be6428

	/// Distinct action candidates at the High threshold.
	measure 'High Priority Actions' = CALCULATE([Action Candidates], KEEPFILTERS('Q4 Action Priority'[Priority Level] = "High"))
		formatString: #,0
		lineageTag: 6273579b-eebc-4b6e-bd38-3e906ba2ba88

	/// Negative Q4 forecast-to-target review candidates at native target grain.
	measure 'Commercial Gap Actions' = CALCULATE([Action Candidates], KEEPFILTERS('Q4 Action Priority'[Action Type] = "Q4_GAP_REVIEW"))
		formatString: #,0
		lineageTag: ea3c50ea-014a-43d7-9450-5f359d7ae9d0

	/// Customer revenue-protection review candidates; relative decline signal, not probability of churn.
	measure 'Customer Protection Actions' = CALCULATE([Action Candidates], KEEPFILTERS('Q4 Action Priority'[Action Type] = "CORE_HIGH_DECLINE_REVIEW"))
		formatString: #,0
		lineageTag: af194d21-c757-4391-a3de-f17d9a458d3f

	/// Potential customer validation candidates; no uplift is estimated.
	measure 'Potential Growth Validation Actions' = CALCULATE([Action Candidates], KEEPFILTERS('Q4 Action Priority'[Action Type] = "POTENTIAL_GROWTH_VALIDATION"))
		formatString: #,0
		lineageTag: ba50db3c-4089-4d28-9d96-8a10fd088dcb

	/// Core High Decline customer actions rated Critical or High for management focus.
	measure 'Critical High Customer Actions' = CALCULATE([Action Candidates], KEEPFILTERS('Q4 Action Priority'[Action Type] = "CORE_HIGH_DECLINE_REVIEW"), KEEPFILTERS('Q4 Action Priority'[Priority Level] IN {"Critical", "High"}))
		formatString: #,0
		lineageTag: c6d55641-2f81-4d85-a8c5-731e76ff28ff

	/// Inventory execution-review candidates rated Critical or High.
	measure 'Critical High Inventory Actions' = CALCULATE([Action Candidates], KEEPFILTERS('Q4 Action Priority'[Action Entity Type] = "Distributor-product inventory position"), KEEPFILTERS('Q4 Action Priority'[Priority Level] IN {"Critical", "High"}))
		formatString: #,0
		lineageTag: 34c23419-6a0d-46dc-a156-194fbf686c38

	/// Mean Build 1 priority score for Critical/High action candidates.
	measure 'Top Priority Average Score' = CALCULATE(AVERAGE('Q4 Action Priority'[Priority Score]), KEEPFILTERS('Q4 Action Priority'[Priority Level] IN {"Critical", "High"}))
		formatString: 0.0
		lineageTag: 17624f51-d7d4-4407-9c6f-9ec6f485bb55

	/// Signed negative-gap amount from Build 1 Q4 gap-review rows only; grouped at Region × Channel × Category.
	measure 'Commercial Q4 Gap (Negative Rows)' = -[Q4 Gross Target Shortfall]
		formatString: $#,##0.00;-$#,##0.00
		lineageTag: 2af244cd-dfa6-4ea3-9c71-de959d08026e

	/// Deduplicated total Jul-Sep 2026 sales for qualifying Potential customers, whether or not their transaction category intersects a negative Q4 gap.
	measure 'Potential Recent 3-Month Sales' = VAR _Customers = CALCULATETABLE(VALUES('Q4 Action Priority'[Customer ID]), KEEPFILTERS('Q4 Action Priority'[Action Type] = "POTENTIAL_GROWTH_VALIDATION")) RETURN SUMX(_Customers, CALCULATE(MAX('Q4 Action Priority'[Recent 3-Month Sales])))
		formatString: $#,##0.00
		lineageTag: e7b67931-5ad1-4965-92d1-b76ed279c476

