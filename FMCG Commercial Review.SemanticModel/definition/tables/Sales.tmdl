	partition Sales = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("D:\Projects\FMCG_Advanced_Practice\processed\fact_sales.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
				in
				    Table.TransformColumnTypes(
				        Promoted,
				        {
				        {"Date", type date},
				        {"Qty", Int64.Type},
				        {"UnitListPrice", type number},
				        {"GrossSales", type number},
				        {"DiscountPct", type number},
				        {"DiscountAmount", type number},
				        {"NetSales", type number},
				        {"COGS", type number},
				        {"GrossMargin", type number},
				        {"PaymentTermDays", Int64.Type}
				        },
				        "en-US"
				    )

