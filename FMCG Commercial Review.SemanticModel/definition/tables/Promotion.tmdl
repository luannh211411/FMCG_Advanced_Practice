	partition Promotion = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("D:\Projects\FMCG_Advanced_Practice\processed\dim_promotion.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
				in
				    Table.TransformColumnTypes(
				        Promoted,
				        {
				        {"StartDate", type date},
				        {"EndDate", type date},
				        {"PromoDiscountPct", type number},
				        {"Budget", type number}
				        },
				        "en-US"
				    )

