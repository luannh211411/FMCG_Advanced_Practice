	partition Customer = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("D:\Projects\FMCG_Advanced_Practice\processed\dim_customer.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
				in
				    Table.TransformColumnTypes(
				        Promoted,
				        {
				        {"CreditLimit", type number},
				        {"JoinDate", type date},
				        {"Latitude", type number},
				        {"Longitude", type number}
				        },
				        "en-US"
				    )

